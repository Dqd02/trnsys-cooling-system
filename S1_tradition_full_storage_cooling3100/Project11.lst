  UNIT   32     TYPE  114     蓄冷水泵                                      
*$UNIT_NAME 蓄冷水泵                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    
*$MODEL .\Hydronics\Pumps\Single Speed\Type114.tmf                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                      
*$POSITION 916 468                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                      
*$LAYER Main #                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                          
*$# SINGLE-SPEED PUMP                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                   
       PARAMETERS   4
! 1 Rated flow rate                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                             
! 2 Fluid specific heat                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                           
! 3 Rated power                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                  
! 4 Motor heat loss fraction                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                       
       4.3000000000000000E+05    4.1899999999999995E+00    4.7900000000000000E+04    0.0000000000000000E+00
       INPUTS    5
! 分流阀-1:Temperature at outlet 2 ->Inlet fluid temperature                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                     
! 分流阀-1:Flow rate at outlet 2 ->Inlet fluid flow rate                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                         
! 判断:ChargePump_ON ->Control signal                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    
! [unconnected] Overall pump efficiency                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            
! [unconnected] Motor efficiency                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                   
       24,3                                     24,4                                     CHARGEPUMP_ON                            CONST                                    CONST                                   
*** INITIAL INPUT VALUES                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                
       2.0000000000000000E+01    3.0000000000000000E+05    0.0000000000000000E+00    6.0000000000000009E-01    9.0000000000000002E-01
*------------------------------------------------------------------------------                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                         
* EQUATIONS "判断"                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                      
*                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                       

  EQUATIONS  39
! 供冷设计温度---------------------------------------------------------------------------------------------------------------------水箱状态判断                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                           
     T_cold_sp = 4
! 暖态度参考温度                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        
     T_warm_ref = 12
! 温度判断死区                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                              
     dT_dead = 1
!蓄冷量状态SOC（0=完全暖/空, 1=完全冷/满）                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                
     SOC = max(0,min(1,(T_warm_ref-[7,5])/(T_warm_ref-T_cold_sp)))
!蓄满：顶部节点AND中部节点均接近供冷温度                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                          
     TankFull = lt([7,18], T_cold_sp + 0.5)*lt([7,30],T_cold_sp + dT_dead)
     TankEmpty = gt([7,42],T_warm_ref-dT_dead)*gt([7,30],T_warm_ref-3)
! SOC < 0.92: 允许开始蓄冷                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        
     Chg_bySOC = lt(SOC,0.95)*(1-TankFull)
! 释冷模式控制信号                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                
     Dch_bySOC = gt(SOC,0.1)*(1-TankEmpty)
! 将负荷由 kJ/h 折算为 kW；                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                         
     LoadKW = [22,1]/3600
! 有效制冷需求判断；5 kW 用于过滤数值噪声，避免零负荷时误开泵                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                     
     HasLoad = gt(LoadKW,5)
! 当前仿真时刻在一天内的小时数；例如 0-8 为夜间蓄冷窗口。                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                               
     HourOfDay = time-24*int(time/24)
! 从 TRNSYS 绝对仿真时间得到日序号；需与负荷文件首日星期对应关系校准。                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                             
     DayNum = int(time/24)
! 未校准的周内索引，范围 0-6 循环。                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                  
     WeekIndex0 = DayNum-7*int(DayNum/7)
! 星期偏移量；必须根据 load_year_15min_new.csv 的首日实际星期校准。                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    
     WeekdayOffset = 0
! 加入偏移量后的周内索引。                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                       
     RawWeekIndex = WeekIndex0+WeekdayOffset
! 归一化后的周内索引；建议约定 0=周一，1=周二，...，6=周日。                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                
     Weekday = RawWeekIndex-7*int(RawWeekIndex/7)
! 工作日判断；周一到周五为 1，周六周日为 0。                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                   
     IsWorkday = lt(Weekday,5)
! 夜间蓄冷时间窗；0:00-8:00 为 1，其余时间为 0。                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                          
     IsChargeTime = lt(HourOfDay,8)
! 工作日白天供冷时间窗；8:00-22:00 为 1，其余时间为 0。                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    
     IsLoadTime = ge(HourOfDay,8)*le(HourOfDay,22)
! 仅工作日夜间允许蓄冷；周末不蓄冷，避免无需求日重复充放。                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                         
     ChargeWindow = IsWorkday*IsChargeTime
! 仅工作日 8:00-22:00 且负荷大于噪声阈值时进入供冷判断。                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                       
     LoadWindow = IsWorkday*IsLoadTime*HasLoad
! 蓄冷模式；夜间、工作日且水箱未满时，两台冷机和蓄冷泵开启。                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                         
     ChargeMode = ChargeWindow*Chg_bySOC
! 水箱释冷模式；白天有负荷且水箱可用时优先释冷，同时与蓄冷模式互斥。                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                      
     TankMode = LoadWindow*Dch_bySOC*(1-ChargeMode)
! 冷机1直供模式；白天有负荷且水箱不可用时立即开启冷机1。                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                           
     ChillerMode = LoadWindow*(1-Dch_bySOC)*(1-ChargeMode)
! 停机模式；不直接连接设备，仅用于检查三种运行模式是否互斥完整。                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                   
     OffMode = (1-ChargeMode)*(1-TankMode)*(1-ChillerMode)
! 冷机1在夜间蓄冷和白天冷机直供时开启。---------------------------------------------------设置启停信号                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                         
     Chiller1_ON = max(ChargeMode,ChillerMode)
! 冷机2只在夜间蓄冷时开启；白天冷机直供只允许冷机1运行。                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        
     Chiller2_ON = ChargeMode
! 供冷水泵-1与冷机1同步，避免冷机1无流量运行。                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                 
     CHWPump1_ON = Chiller1_ON
! 供冷水泵-2与冷机2同步，避免冷机2无流量运行。                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                 
     CHWPump2_ON = Chiller2_ON
! Unit32 蓄冷水泵只在夜间蓄冷模式开启。                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                       
     ChargePump_ON = ChargeMode
! Unit6 释冷水泵只在蓄冷罐白天释冷模式开启。                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                 
     DischargePump_ON = TankMode
!  回水水泵在所有白天供冷模式开启；夜间蓄冷无负荷回水，关闭。水箱释冷为1，不足且冷机供应为0.5                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                 
     ReturnPump_ON = TankMode + 0.5*ChillerMode
! 冷却水泵1与冷机1同步。                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                      
     CondPump1_ON = Chiller1_ON
 
*** Warning at time       :         0.000000
    Generated by Unit     : Not applicable or not available
    Generated by Type     : Not applicable or not available
    TRNSYS Message     11 : The TRNSYS processor has reported an illegal variable name in an EQUATIONS or CONSTANTS card.  Equations or constants must not begin with END, INC, EQU or CON as these are protected codes required when reading the TRNSYS input file.  The offending variable name is listed below.
    Reported information  : CONDPUMP1_ON
 
! 冷却水泵2与冷机2同步。                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                      
     CondPump2_ON = Chiller2_ON
 
*** Warning at time       :         0.000000
    Generated by Unit     : Not applicable or not available
    Generated by Type     : Not applicable or not available
    TRNSYS Message     11 : The TRNSYS processor has reported an illegal variable name in an EQUATIONS or CONSTANTS card.  Equations or constants must not begin with END, INC, EQU or CON as these are protected codes required when reading the TRNSYS input file.  The offending variable name is listed below.
    Reported information  : CONDPUMP2_ON
 
! 冷却塔1与冷机1同步，冷机1不开时不应开塔。                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                      
     Tower1_ON = Chiller1_ON
! 冷却塔2与冷机2同步，白天冷机1直供时冷却塔2保持关闭。                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                           
     Tower2_ON = Chiller2_ON
! Unit24 分流阀-1：蓄冷时 gam=1，全部走 outlet2 到蓄冷水泵；冷机直供时 gam=0，全部走 outlet1 到供冷总管。                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                           
     Gamma24 = ChargeMode
! Unit29 分流阀-3：水箱释冷时 gam=0，回水走 outlet1 回蓄冷罐；冷机直供时 gam=1，回水走 outlet2 回冷机侧。                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                          
     Gamma29 = ChillerMode
! Unit14 分流阀-2：蓄冷时 gam=0.5，两台冷机各 50%；冷机1直供时 gam=0，全部回冷机1。                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                             
     Gamma14 = 0.5*ChargeMode
