*------------------------------------------------------------------------------

* EQUATIONS "判断"
* 
EQUATIONS 60
T_cold_sp = 4 ! 水箱冷态参考温度---------------------------------------------------------------------------------------------------------------------水箱状态判断
T_warm_ref = 12 ! 水箱暖态参考温度
dT_dead = 1 ! 温度判断死区
SOC = max(0,min(1,(T_warm_ref-[7,5])/(T_warm_ref-T_cold_sp))) !蓄冷量状态SOC（0=完全暖/空, 1=完全冷/满）
TankFull = lt([7,18], T_cold_sp + 0.5)*lt([7,30],T_cold_sp + dT_dead) !蓄满：顶部节点AND中部节点均接近供冷温度
TankEmpty = gt([7,42],T_warm_ref-dT_dead)*gt([7,30],T_warm_ref-3)
SOC_Stop = max(SOC,TankFull) ! Type2蓄冷停止滞回的监测量；TankFull=1时强制将监测量提升到1，使滞回控制器进入停止蓄冷状态
Chg_bySOC = (1-[58,1])*(1-TankFull) ! Type2未锁定停止且水箱未判满时允许蓄冷；带0.93/0.95 SOC滞回
Dch_bySOC = gt(SOC,0.1)*(1-TankEmpty) ! 释冷模式控制信号
LoadKW = max(0,[22,1]/3600)! 将负荷由 kJ/h 折算为 kW；
HasLoad = gt(LoadKW,5)! 有效制冷需求判断；5 kW 用于过滤数值噪声，避免零负荷时误开泵
HourOfDay = time-24*int(time/24)! 当前仿真时刻在一天内的小时数；例如 0-8 为夜间蓄冷窗口。
DayNum = int(time/24)! 从 TRNSYS 绝对仿真时间得到日序号；需与负荷文件首日星期对应关系校准。
WeekIndex0 = DayNum-7*int(DayNum/7)! 未校准的周内索引，范围 0-6 循环。
WeekdayOffset = 0! 星期偏移量；必须根据 load_year_15min_new.csv 的首日实际星期校准。
RawWeekIndex = WeekIndex0+WeekdayOffset! 加入偏移量后的周内索引。
Weekday = RawWeekIndex-7*int(RawWeekIndex/7)! 归一化后的周内索引；建议约定 0=周一，1=周二，...，6=周日。
IsWorkday = lt(Weekday,5)! 工作日判断；周一到周五为 1，周六周日为 0。
IsChargeTime = lt(HourOfDay,8)! 夜间蓄冷时间窗；0:00-8:00 为 1，其余时间为 0。
IsLoadTime = ge(HourOfDay,8)*lt(HourOfDay,22)! 工作日白天供冷时间窗；8:00-22:00 为 1，其余时间为 0。
ChargeWindow = IsWorkday*IsChargeTime! 仅工作日夜间允许蓄冷；周末不蓄冷，避免无需求日重复充放。
LoadWindow = IsWorkday*IsLoadTime*HasLoad! 仅工作日 8:00-22:00 且负荷大于噪声阈值时进入供冷判断。
ChargeMode = ChargeWindow*Chg_bySOC! 蓄冷模式；夜间、工作日且水箱未满时，两台冷机和蓄冷泵开启。
TankMode = LoadWindow*TankCanCover*(1-ChargeMode)! 水箱释冷模式；白天有负荷且水箱可用时优先释冷，同时与蓄冷模式互斥。
ChillerMode = LoadWindow*(1-TankCanCover)*(1-ChargeMode)! 双冷机各承担一半
OffMode = (1-ChargeMode)*(1-TankMode)*(1-ChillerMode)! 停机模式；不直接连接设备，仅用于检查三种运行模式是否互斥完整。
Chiller1_ON = max(ChargeMode,ChillerMode)
Chiller2_ON = max(ChargeMode,ChillerMode)
CHWPump1_ON = CHWP1_CTRL
CHWPump2_ON = CHWP2_CTRL
ChargePump_ON = ChargeMode! 蓄冷水泵只在夜间蓄冷模式开启。
Tower1_ON = Chiller1_ON! 冷却塔1与冷机1同步，冷机1不开时不应开塔。
Tower2_ON = Chiller2_ON! 冷却塔2与冷机2同步
Gamma24 = ChargeMode! Unit24 分流阀-1：蓄冷时 gam=1，全部走 outlet2 到蓄冷水泵；冷机直供时 gam=0，全部走 outlet1 到供冷总管。
Gamma29 = ChillerMode! Unit29 分流阀-3：水箱释冷时 gam=0，回水走 outlet1 回蓄冷罐；冷机直供时 gam=1，回水走 outlet2 回冷机侧。
Gamma14 = 0.5*max(ChargeMode,ChillerMode)! Unit14 分流阀-2：蓄冷时 gam=0.5，两台冷机各 50%；
CpW = 4.19! 水的比热
DTCHW_TANK = 8 ! 设计供回水温差
MCHWR = 215000 !单台供冷泵额定质量流量，kg/h
MDCHR = 430000!释冷泵额定质量流量，kg/h
MREQ_TANK = LoadKW*3600/(CpW*DTCHW_TANK)!由建筑冷负荷计算总需求质量流量
MDCHREQ = 1.10*MREQ_TANK!给释冷流量增加输送裕量
TankCanCover = Dch_bySOC*TankFlowOK!水箱未判空且泵流量能力足够时允许独立供冷
TankFlowOK = le(MDCHREQ,MDCHR)!需求流量不超过释冷泵额定流量时为1
DCHP_CTRL = TankMode*min(1,MDCHREQ/MDCHR)!计算Unit49应使用的0-1连续释冷信号
CHGP_CTRL = ChargeMode!计算Unit50应使用的蓄冷泵信号
CHW_DAY_CTRL = ChillerMode*min(1,MDCHREQ/(2*MCHWR))!双冷机供冷时，每台供冷泵承担总流量的一半
CHWP1_CTRL = max(ChargeMode,CHW_DAY_CTRL)!Unit51夜间取1，白天按一半需求调节
CHWP2_CTRL = max(ChargeMode,CHW_DAY_CTRL)
T_CHW_CHARGE = 4 ! 蓄冷模式冷机冷冻水出水设定值，°C
T_CHW_DIRECT = 10 ! 冷机直接供建筑时的冷冻水出水设定值，°C
T_CHW_OFF = 10 ! 冷机关闭或释冷模式下的备用设定值，°C；此时不产生制冷
CHW_SP = max(4,min(10,T_CHW_CHARGE*ChargeMode + T_CHW_DIRECT*ChillerMode + T_CHW_OFF*(TankMode+OffMode))) ! 两台Type666共用的动态冷冻水出水设定值
ModeSumCheck = ChargeMode+TankMode+ChillerMode+OffMode!逻辑验证，应满足 ModeSumCheck=1；如果不是1，先修正模式逻辑，不要直接调冷机设定温度。
TWC_set = min(35,max(26.67,[23,3]+4.5))
Fan1 = -Tower1_ON
Fan2 = -Tower2_ON
DTCHW_DIRECT = 5
DTCHW = DTCHW_DIRECT*ChillerMode + DTCHW_TANK*(1-ChillerMode)
MREQ = LoadKW*3600/(CpW*DTCHW)
*$UNIT_NAME 判断
*$LAYER Main
*$POSITION 927 63
*$UNIT_NUMBER 34

*------------------------------------------------------------------------------


