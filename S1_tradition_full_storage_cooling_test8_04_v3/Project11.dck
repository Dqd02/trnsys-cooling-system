lengji_all = ([9,5]+[12,5])/3600
lengqueta_all = ([57,4]+[47,4])/3600
shuibeng_all = ([49,3]+[50,3]+[51,3]+[52,3]+[53,3]+[54,3]+[55,3]+[56,3])/3600
E_ALL = lengji_all+lengqueta_all+shuibeng_all
E_CO2_2025 = E_ALL*[36,1]
E_CO2_40TH = E_ALL*[36,2]
E_CO2_60TH = E_ALL*[36,3]
