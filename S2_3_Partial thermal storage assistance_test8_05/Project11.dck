* Model "闭式冷却塔2" (Type 510)
* 

UNIT 61 TYPE 510	 闭式冷却塔2
*$UNIT_NAME 闭式冷却塔2
*$MODEL .\HVAC Library (TESS)\Closed Circuit Cooling Tower\Type510.tmf
*$POSITION 608 959
*$LAYER Main # 
*$# CLOSED CIRCUIT COOLING TOWER
PARAMETERS 15
2		! 1 Humidity mode
37.6		! 2 Design inlet fluid temperature
32		! 3 Design outlet fluid temperature
399600		! 4 Design fluid flow rate
4.190		! 5 Fluid specific heat
32		! 6 Design ambient air temperature
28.2		! 7 Design wet bulb temperature
600000		! 8 Design air flow rate
1.0		! 9 Air pressure at design conditions
216000		! 10 Rated fan power
4		! 11 Number of power coefficients
0.02		! 12 Power coefficient-1
0		! 13 Power coefficient-2
0		! 14 Power coefficient-3
0.98		! 15 Power coefficient-4
INPUTS 8
17,1 		! 管道-3:Outlet temperature ->Fluid inlet temperature
17,2 		! 管道-3:Outlet flow rate ->Fluid flow rate
23,1 		! 天气文件:Dry bulb temperature ->Ambient temperature
23,6 		! 天气文件:Humidity ratio ->Ambient humidity ratio
23,7 		! 天气文件:Percent relative humidity ->Ambient % RH
23,10 		! 天气文件:Atmospheric pressure ->Ambient air pressure
Fan2		! 冷却塔信号:Fan2 ->Fan control signal
TWC_set		! 冷却塔信号:TWC_set ->Desired Outlet Temperature
*** INITIAL INPUT VALUES
10.0 0.0 20.0 0.005 50.0 1.0 0 30.0 
*------------------------------------------------------------------------------

* EQUATIONS "冷却塔信号"
* 
EQUATIONS 21
CpW2 = 4.19
TWC_MIN = 20 !冷却塔出水温度下限，°C。
TWC_MAX = 32 !冷却塔目标出水温度上限，°C。
CT_APPROACH = 4! 冷却塔目标逼近度，K。
TWC_set = min(TWC_MAX,max(TWC_MIN,[23,3]+CT_APPROACH)) ! 冷却塔动态目标出水温度，°C。
QCT_R = 9376214 ! 单台Type510的额定散热量，kJ/h。冷却塔散热量 = 冷机蒸发器制冷量 + 压缩机输入功率;QCT_R即 m_cw,R×CpW×ΔT_R
FAN_MIN = 0.25! 冷却塔风机最低相对转速。
KP_CT = 0.10! 出水温度偏差修正系数，单位近似为1/K。
CW_FLOW_ON = 75000! 冷却塔允许启动的最低检测流量，kg/h。
Qrej1 = max(0,[9,6])!Type666的实际冷凝排热量，kJ/h。
Qrej2 = max(0,[12,6])
FlowOK1 = gt([9,4] , CW_FLOW_ON)!该判断可以避免无水流时冷却塔风机仍然运行。
FlowOK2 = gt([12,4] , CW_FLOW_ON)
QFrac1 = min(1,Qrej1/QCT_R)
QFrac2 = min(1,Qrej2/QCT_R)!当前排热量占冷却塔额定散热量的比例。
ToutEst1 = [9,3] - Qrej1/(CpW2*max(CW_FLOW_ON , [9,4])) !估算得到的冷却塔出水温度
ToutEst2 = [12,3] - Qrej2/(CpW2*max(CW_FLOW_ON , [12,4]))
FanCmd1 = max(FAN_MIN,min(1,FAN_MIN+(1-FAN_MIN)*QFrac1+KP_CT*(ToutEst1-TWC_set)))!生成0.25～1.00的正变频信号
FanCmd2 = max(FAN_MIN,min(1,FAN_MIN+(1-FAN_MIN)*QFrac2+KP_CT*(ToutEst2-TWC_set)))
Fan1 = Tower1_ON*FlowOK1*FanCmd1 !生成Type510最终风机控制信号
Fan2 = Tower2_ON*FlowOK2*FanCmd2
*$UNIT_NAME 冷却塔信号
*$LAYER Main
*$POSITION 615 1130
*$UNIT_NUMBER 62

