* EQUATIONS "Equa-4"
* 
EQUATIONS 39
ACH_bgs2 = ([46,6]+m_oa_bgs2)/(1.2*V_BGS2)
V_BGS2 = 800*4.9
V_HYS2 = 400*4.9
V_CS2 = 99.2*4.9
V_ZL2 = 300.034*4.9
cool_bgs2 = [51,1]*[53,1]
cool_hys2 = [51,1]*[54,1]
cool_cs2 = [51,1]*[55,1]
cool_zl2 = [51,1]*[57,1]
ACH_hys2 = ([48,6]+m_oa_hys2)/(1.2*V_HYS2)
ACH_cs2 = ([49,6])/(1.2*V_CS2)
ACH_zl2 = ([50,6]+m_oa_zl2)/(1.2*V_ZL2)
Chiller_on2 = max(max(cool_zl2,cool_hys2),max(cool_bgs2,cool_cs2))
T_return_raw2 = ([46,2]*[46,1]+[48,1]*[48,2]+[49,2]*[49,1]+[50,1]*[50,2]+[58,2]*[58,1])/max(1,m_load2)
T_chws_set2 = 8
T_return_floor2 = Chiller_on2*T_return_raw2 + (1-Chiller_on2)*(T_chws_set2 + 5)
m_bgs2 = 14380*cool_bgs2
m_hys2 = 7420*cool_hys2
m_cs2 = 2290*cool_cs2
m_zl2 = 6635*cool_zl2
m_oa2 = [58,2]*[51,1]
m_load2 = m_bgs2+m_hys2+m_cs2+m_zl2+m_oa2
m_min2 = 0.3*30725
m_chiller2 = max( Chiller_on2 * max(m_load2, m_min2), 0.01 )
m_bypass2 = max(0,m_chiller2-m_load2)
m_oa_bgs2 = 0.60*[58,6]
m_oa_hys2 = 0.25*[58,6]
m_oa_zl2 = 0.15*[58,6]
T_bgs2 = ([46,3]*[46,6] + m_oa_bgs2*[58,3])/max(0.01,m_oa_bgs2+[46,6])
T_hys2 = ([48,3]*[48,6] + m_oa_hys2*[58,3])/max(0.01,m_oa_hys2+[48,6])
T_cs2 = ([49,3]*[49,6] )/max(0.01,[49,6])
T_zl2 = ([50,3]*[50,6] + m_oa_zl2*[58,3])/max(0.01,m_oa_zl2+[50,6])
W_bgs2 = ([46,6]*[46,4] + [58,4]* m_oa_bgs2)/max(0.01, m_oa_bgs2+[46,6])
W_hys2 = ([48,6]*[48,4] + [58,4]*m_oa_hys2)/max(0.01, m_oa_hys2+[48,6])
W_cs2 = ([49,6]*[49,4] )/max(0.01,[49,6])
W_zl2 = ([50,6]*[50,4] + [58,4]*m_oa_zl2)/max(0.01,m_oa_zl2+[50,6])
m_oa_coil2 = [51,1]*12500
W_oa_want2 = 0.0095
m_oa_air2 = [51,1]*5200
*$UNIT_NAME Equa-4
*$LAYER Main
*$POSITION 1059 1802
*$UNIT_NUMBER 52

