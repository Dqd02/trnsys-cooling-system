* EQUATIONS "Equa-9"
* 
EQUATIONS 39
ACH_bgs7 = ([124,6]+m_oa_bgs7)/(1.2*V_BGS7)
V_BGS7 = 800*4.9
V_HYS7 = 400*4.9
V_CS7 = 99.2*4.9
V_ZL7 = 300.034*4.9
cool_bgs7 = [129,1]*[131,1]
cool_hys7 = [129,1]*[132,1]
cool_cs7 = [129,1]*[133,1]
cool_zl7 = [129,1]*[134,1]
ACH_hys7 = ([126,6]+m_oa_hys7)/(1.2*V_HYS7)
ACH_cs7 = ([127,6])/(1.2*V_CS7)
ACH_zl7 = ([128,6]+m_oa_zl7)/(1.2*V_ZL7)
Chiller_on7 = max(max(cool_zl7,cool_hys7),max(cool_bgs7,cool_cs7))
T_return_raw7 = ([124,2]*[124,1]+[126,1]*[126,2]+[127,2]*[127,1]+[128,1]*[128,2]+[135,2]*[135,1])/max(1,m_load7)
T_chws_set7 = 8
T_return_floor7 = Chiller_on7*T_return_raw7 + (1-Chiller_on7)*(T_chws_set7 + 5)
m_bgs7 = 14380*cool_bgs7
m_hys7 = 7420*cool_hys7
m_cs7 = 2290*cool_cs7
m_zl7 = 6635*cool_zl7
m_oa7 = [135,2]*[129,1]
m_load7 = m_bgs7+m_hys7+m_cs7+m_zl7+m_oa7
m_min7 = 0.3*30725
m_chiller7 = max( Chiller_on7 * max(m_load7, m_min7), 0.01 )
m_bypass7 = max(0,m_chiller7-m_load7)
m_oa_bgs7 = 0.60*[135,6]
m_oa_hys7 = 0.25*[135,6]
m_oa_zl7 = 0.15*[135,6]
T_bgs7 = ([124,3]*[124,6] + m_oa_bgs7*[135,3])/max(0.01,m_oa_bgs7+[124,6])
T_hys7 = ([126,3]*[126,6] + m_oa_hys7*[135,3])/max(0.01,m_oa_hys7+[126,6])
T_cs7 = ([127,3]*[127,6] )/max(0.01,[127,6])
T_zl7 = ([128,3]*[128,6] + m_oa_zl7*[135,3])/max(0.01,m_oa_zl7+[128,6])
W_bgs7 = ([124,6]*[124,4] + [135,4]* m_oa_bgs7)/max(0.01, m_oa_bgs7+[124,6])
W_hys7 = ([126,6]*[126,4] + [135,4]*m_oa_hys7)/max(0.01, m_oa_hys7+[126,6])
W_cs7 = ([127,6]*[127,4] )/max(0.01,[127,6])
W_zl7 = ([128,6]*[128,4] + [135,4]*m_oa_zl7)/max(0.01,m_oa_zl7+[128,6])
m_oa_coil7 = [129,1]*12500
W_oa_want7 = 0.0095
m_oa_air7 = [129,1]*5200
*$UNIT_NAME Equa-9
*$LAYER Main
*$POSITION 1424 2026
*$UNIT_NUMBER 130

