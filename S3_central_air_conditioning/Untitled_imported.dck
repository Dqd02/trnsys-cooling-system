* EQUATIONS "Equa-8"
* 
EQUATIONS 39
ACH_bgs6 = ([109,6]+m_oa_bgs6)/(1.2*V_BGS6)
V_BGS6 = 800*4.9
V_HYS6 = 400*4.9
V_CS6 = 99.2*4.9
V_ZL6 = 300.034*4.9
cool_bgs6 = [114,1]*[116,1]
cool_hys6 = [114,1]*[117,1]
cool_cs6 = [114,1]*[118,1]
cool_zl6 = [114,1]*[119,1]
ACH_hys6 = ([111,6]+m_oa_hys6)/(1.2*V_HYS6)
ACH_cs6 = ([112,6])/(1.2*V_CS6)
ACH_zl6 = ([113,6]+m_oa_zl6)/(1.2*V_ZL6)
Chiller_on6 = max(max(cool_zl6,cool_hys6),max(cool_bgs6,cool_cs6))
T_return_raw6 = ([109,2]*[109,1]+[111,1]*[111,2]+[112,2]*[112,1]+[113,1]*[113,2]+[120,2]*[120,1])/max(1,m_load6)
T_chws_set6 = 8
T_return_floor6 = Chiller_on6*T_return_raw6 + (1-Chiller_on6)*(T_chws_set6 + 5)
m_bgs6 = 14380*cool_bgs6
m_hys6 = 7420*cool_hys6
m_cs6 = 2290*cool_cs6
m_zl6 = 6635*cool_zl6
m_oa6 = [120,2]*[114,1]
m_load6 = m_bgs6+m_hys6+m_cs6+m_zl6+m_oa6
m_min6 = 0.3*30725
m_chiller6 = max( Chiller_on6 * max(m_load6, m_min6), 0.01 )
m_bypass6 = max(0,m_chiller6-m_load6)
m_oa_bgs6 = 0.60*[120,6]
m_oa_hys6 = 0.25*[120,6]
m_oa_zl6 = 0.15*[120,6]
T_bgs6 = ([109,3]*[109,6] + m_oa_bgs6*[120,3])/max(0.01,m_oa_bgs6+[109,6])
T_hys6 = ([111,3]*[111,6] + m_oa_hys6*[120,3])/max(0.01,m_oa_hys6+[111,6])
T_cs6 = ([112,3]*[112,6] )/max(0.01,[112,6])
T_zl6 = ([113,3]*[113,6] + m_oa_zl6*[120,3])/max(0.01,m_oa_zl6+[113,6])
W_bgs6 = ([109,6]*[109,4] + [120,4]* m_oa_bgs6)/max(0.01, m_oa_bgs6+[109,6])
W_hys6 = ([111,6]*[111,4] + [120,4]*m_oa_hys6)/max(0.01, m_oa_hys6+[111,6])
W_cs6 = ([112,6]*[112,4] )/max(0.01,[112,6])
W_zl6 = ([113,6]*[113,4] + [120,4]*m_oa_zl6)/max(0.01,m_oa_zl6+[113,6])
m_oa_coil6 = [114,1]*12500
W_oa_want6 = 0.0095
m_oa_air6 = [114,1]*5200
*$UNIT_NAME Equa-8
*$LAYER Main
*$POSITION 1125 1780
*$UNIT_NUMBER 115

