* EQUATIONS "Equa-13"
* 
EQUATIONS 39
ACH_bgs11 = ([184,6]+m_oa_bgs11)/(1.2*V_BGS11)
V_BGS11 = 800*4.9
V_HYS11 = 400*4.9
V_CS11 = 99.2*4.9
V_ZL11 = 300.034*4.9
cool_bgs11 = [189,1]*[191,1]
cool_hys11 = [189,1]*[192,1]
cool_cs11 = [189,1]*[193,1]
cool_zl11 = [189,1]*[194,1]
ACH_hys11 = ([186,6]+m_oa_hys11)/(1.2*V_HYS11)
ACH_cs11 = ([187,6])/(1.2*V_CS11)
ACH_zl11 = ([188,6]+m_oa_zl11)/(1.2*V_ZL11)
Chiller_on11 = max(max(cool_zl11,cool_hys11),max(cool_bgs11,cool_cs11))
T_return_raw11 = ([184,2]*[184,1]+[186,1]*[186,2]+[187,2]*[187,1]+[188,1]*[188,2]+[195,2]*[195,1])/max(1,m_load11)
T_chws_set11 = 8
T_return_floor11 = Chiller_on11*T_return_raw11 + (1-Chiller_on11)*(T_chws_set11 + 5)
m_bgs11 = 14380*cool_bgs11
m_hys11 = 7420*cool_hys11
m_cs11 = 2290*cool_cs11
m_zl11 = 6635*cool_zl11
m_oa11 = [195,2]*[189,1]
m_load11 = m_bgs11+m_hys11+m_cs11+m_zl11+m_oa11
m_min11 = 0.3*30725
m_chiller11 = max( Chiller_on11 * max(m_load11, m_min11), 0.01 )
m_bypass11 = max(0,m_chiller11-m_load11)
m_oa_bgs11 = 0.60*[195,6]
m_oa_hys11 = 0.25*[195,6]
m_oa_zl11 = 0.15*[195,6]
T_bgs11 = ([184,3]*[184,6] + m_oa_bgs11*[195,3])/max(0.01,m_oa_bgs11+[184,6])
T_hys11 = ([186,3]*[186,6] + m_oa_hys11*[195,3])/max(0.01,m_oa_hys11+[186,6])
T_cs11 = ([187,3]*[187,6] )/max(0.01,[187,6])
T_zl11 = ([188,3]*[188,6] + m_oa_zl11*[195,3])/max(0.01,m_oa_zl11+[188,6])
W_bgs11 = ([184,6]*[184,4] + [195,4]* m_oa_bgs11)/max(0.01, m_oa_bgs11+[184,6])
W_hys11 = ([186,6]*[186,4] + [195,4]*m_oa_hys11)/max(0.01, m_oa_hys11+[186,6])
W_cs11 = ([187,6]*[187,4] )/max(0.01,[187,6])
W_zl11 = ([188,6]*[188,4] + [195,4]*m_oa_zl11)/max(0.01,m_oa_zl11+[188,6])
m_oa_coil11 = [189,1]*12500
W_oa_want11 = 0.0095
m_oa_air11 = [189,1]*5200
*$UNIT_NAME Equa-13
*$LAYER Main
*$POSITION 1638 2274
*$UNIT_NUMBER 190

