* EQUATIONS "Equa-10"
* 
EQUATIONS 39
ACH_bgs8 = ([139,6]+m_oa_bgs8)/(1.2*V_BGS8)
V_BGS8 = 800*4.9
V_HYS8 = 400*4.9
V_CS8 = 99.2*4.9
V_ZL8 = 300.034*4.9
cool_bgs8 = [144,1]*[146,1]
cool_hys8 = [144,1]*[147,1]
cool_cs8 = [144,1]*[148,1]
cool_zl8 = [144,1]*[149,1]
ACH_hys8 = ([141,6]+m_oa_hys8)/(1.2*V_HYS8)
ACH_cs8 = ([142,6])/(1.2*V_CS8)
ACH_zl8 = ([143,6]+m_oa_zl8)/(1.2*V_ZL8)
Chiller_on8 = max(max(cool_zl8,cool_hys8),max(cool_bgs8,cool_cs8))
T_return_raw8 = ([139,2]*[139,1]+[141,1]*[141,2]+[142,2]*[142,1]+[143,1]*[143,2]+[150,2]*[150,1])/max(1,m_load8)
T_chws_set8 = 8
T_return_floor8 = Chiller_on8*T_return_raw8 + (1-Chiller_on8)*(T_chws_set8 + 5)
m_bgs8 = 14380*cool_bgs8
m_hys8 = 7420*cool_hys8
m_cs8 = 2290*cool_cs8
m_zl8 = 6635*cool_zl8
m_oa8 = [150,2]*[144,1]
m_load8 = m_bgs8+m_hys8+m_cs8+m_zl8+m_oa8
m_min8 = 0.3*30725
m_chiller8 = max( Chiller_on8 * max(m_load8, m_min8), 0.01 )
m_bypass8 = max(0,m_chiller8-m_load8)
m_oa_bgs8 = 0.60*[150,6]
m_oa_hys8 = 0.25*[150,6]
m_oa_zl8 = 0.15*[150,6]
T_bgs8 = ([139,3]*[139,6] + m_oa_bgs8*[150,3])/max(0.01,m_oa_bgs8+[139,6])
T_hys8 = ([141,3]*[141,6] + m_oa_hys8*[150,3])/max(0.01,m_oa_hys8+[141,6])
T_cs8 = ([142,3]*[142,6] )/max(0.01,[142,6])
T_zl8 = ([143,3]*[143,6] + m_oa_zl8*[150,3])/max(0.01,m_oa_zl8+[143,6])
W_bgs8 = ([139,6]*[139,4] + [150,4]* m_oa_bgs8)/max(0.01, m_oa_bgs8+[139,6])
W_hys8 = ([141,6]*[141,4] + [150,4]*m_oa_hys8)/max(0.01, m_oa_hys8+[141,6])
W_cs8 = ([142,6]*[142,4] )/max(0.01,[142,6])
W_zl8 = ([143,6]*[143,4] + [150,4]*m_oa_zl8)/max(0.01,m_oa_zl8+[143,6])
m_oa_coil8 = [144,1]*12500
W_oa_want8 = 0.0095
m_oa_air8 = [144,1]*5200
*$UNIT_NAME Equa-10
*$LAYER Main
*$POSITION 1446 2036
*$UNIT_NUMBER 145

