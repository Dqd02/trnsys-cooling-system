* EQUATIONS "Equa-12"
* 
EQUATIONS 39
ACH_bgs10 = ([169,6]+m_oa_bgs10)/(1.2*V_BGS10)
V_BGS10 = 800*4.9
V_HYS10 = 400*4.9
V_CS10 = 99.2*4.9
V_ZL10 = 300.034*4.9
cool_bgs10 = [174,1]*[176,1]
cool_hys10 = [174,1]*[177,1]
cool_cs10 = [174,1]*[178,1]
cool_zl10 = [174,1]*[179,1]
ACH_hys10 = ([171,6]+m_oa_hys10)/(1.2*V_HYS10)
ACH_cs10 = ([172,6])/(1.2*V_CS10)
ACH_zl10 = ([173,6]+m_oa_zl10)/(1.2*V_ZL10)
Chiller_on10 = max(max(cool_zl10,cool_hys10),max(cool_bgs10,cool_cs10))
T_return_raw10 = ([169,2]*[169,1]+[171,1]*[171,2]+[172,2]*[172,1]+[173,1]*[173,2]+[180,2]*[180,1])/max(1,m_load10)
T_chws_set10 = 8
T_return_floor10 = Chiller_on10*T_return_raw10 + (1-Chiller_on10)*(T_chws_set10 + 5)
m_bgs10 = 14380*cool_bgs10
m_hys10 = 7420*cool_hys10
m_cs10 = 2290*cool_cs10
m_zl10 = 6635*cool_zl10
m_oa10 = [180,2]*[174,1]
m_load10 = m_bgs10+m_hys10+m_cs10+m_zl10+m_oa10
m_min10 = 0.3*30725
m_chiller10 = max( Chiller_on10 * max(m_load10, m_min10), 0.01 )
m_bypass10 = max(0,m_chiller10-m_load10)
m_oa_bgs10 = 0.60*[180,6]
m_oa_hys10 = 0.25*[180,6]
m_oa_zl10 = 0.15*[180,6]
T_bgs10 = ([169,3]*[169,6] + m_oa_bgs10*[180,3])/max(0.01,m_oa_bgs10+[169,6])
T_hys10 = ([171,3]*[171,6] + m_oa_hys10*[180,3])/max(0.01,m_oa_hys10+[171,6])
T_cs10 = ([172,3]*[172,6] )/max(0.01,[172,6])
T_zl10 = ([173,3]*[173,6] + m_oa_zl10*[180,3])/max(0.01,m_oa_zl10+[173,6])
W_bgs10 = ([169,6]*[169,4] + [180,4]* m_oa_bgs10)/max(0.01, m_oa_bgs10+[169,6])
W_hys10 = ([171,6]*[171,4] + [180,4]*m_oa_hys10)/max(0.01, m_oa_hys10+[171,6])
W_cs10 = ([172,6]*[172,4] )/max(0.01,[172,6])
W_zl10 = ([173,6]*[173,4] + [180,4]*m_oa_zl10)/max(0.01,m_oa_zl10+[173,6])
m_oa_coil10 = [174,1]*12500
W_oa_want10 = 0.0095
m_oa_air10 = [174,1]*5200
*$UNIT_NAME Equa-12
*$LAYER Main
*$POSITION 1595 2207
*$UNIT_NUMBER 175

