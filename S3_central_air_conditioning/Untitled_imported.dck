* EQUATIONS "Equa-6"
* 
EQUATIONS 39
ACH_bgs4 = ([78,6]+m_oa_bgs4)/(1.2*V_BGS4)
V_BGS4 = 800*4.9
V_HYS4 = 400*4.9
V_CS4 = 99.2*4.9
V_ZL4 = 300.034*4.9
cool_bgs4 = [83,1]*[85,1]
cool_hys4 = [83,1]*[86,1]
cool_cs4 = [83,1]*[87,1]
cool_zl4 = [83,1]*[88,1]
ACH_hys4 = ([80,6]+m_oa_hys4)/(1.2*V_HYS4)
ACH_cs4 = ([81,6])/(1.2*V_CS4)
ACH_zl4 = ([82,6]+m_oa_zl4)/(1.2*V_ZL4)
Chiller_on4 = max(max(cool_zl4,cool_hys4),max(cool_bgs4,cool_cs4))
T_return_raw4 = ([78,2]*[78,1]+[80,1]*[80,2]+[81,2]*[81,1]+[82,1]*[82,2]+[89,2]*[89,1])/max(1,m_load4)
T_chws_set4 = 8
T_return_floor4 = Chiller_on4*T_return_raw4 + (1-Chiller_on4)*(T_chws_set4 + 5)
m_bgs4 = 14380*cool_bgs4
m_hys4 = 7420*cool_hys4
m_cs4 = 2290*cool_cs4
m_zl4 = 6635*cool_zl4
m_oa4 = [89,2]*[83,1]
m_load4 = m_bgs4+m_hys4+m_cs4+m_zl4+m_oa4
m_min4 = 0.3*30725
m_chiller4 = max( Chiller_on4 * max(m_load4, m_min4), 0.01 )
m_bypass4 = max(0,m_chiller4-m_load4)
m_oa_bgs4 = 0.60*[89,6]
m_oa_hys4 = 0.25*[89,6]
m_oa_zl4 = 0.15*[89,6]
T_bgs4 = ([78,3]*[78,6] + m_oa_bgs4*[89,3])/max(0.01,m_oa_bgs4+[78,6])
T_hys4 = ([80,3]*[80,6] + m_oa_hys4*[89,3])/max(0.01,m_oa_hys4+[80,6])
T_cs4 = ([81,3]*[81,6] )/max(0.01,[81,6])
T_zl4 = ([82,3]*[82,6] + m_oa_zl4*[89,3])/max(0.01,m_oa_zl4+[82,6])
W_bgs4 = ([78,6]*[78,4] + [89,4]* m_oa_bgs4)/max(0.01, m_oa_bgs4+[78,6])
W_hys4 = ([80,6]*[80,4] + [89,4]*m_oa_hys4)/max(0.01, m_oa_hys4+[80,6])
W_cs4 = ([81,6]*[81,4] )/max(0.01,[81,6])
W_zl4 = ([82,6]*[82,4] + [89,4]*m_oa_zl4)/max(0.01,m_oa_zl4+[82,6])
m_oa_coil4 = [83,1]*12500
W_oa_want4 = 0.0095
m_oa_air4 = [83,1]*5200
*$UNIT_NAME Equa-6
*$LAYER Main
*$POSITION 1200 1738
*$UNIT_NUMBER 84

