* EQUATIONS "Equa-7"
* 
EQUATIONS 39
ACH_bgs5 = ([94,6]+m_oa_bgs5)/(1.2*V_BGS5)
V_BGS5 = 800*4.9
V_HYS5 = 400*4.9
V_CS5 = 99.2*4.9
V_ZL5 = 300.034*4.9
cool_bgs5 = [99,1]*[101,1]
cool_hys5 = [99,1]*[102,1]
cool_cs5 = [99,1]*[103,1]
cool_zl5 = [99,1]*[104,1]
ACH_hys5 = ([96,6]+m_oa_hys5)/(1.2*V_HYS5)
ACH_cs5 = ([97,6])/(1.2*V_CS5)
ACH_zl5 = ([98,6]+m_oa_zl5)/(1.2*V_ZL5)
Chiller_on5 = max(max(cool_zl5,cool_hys5),max(cool_bgs5,cool_cs5))
T_return_raw5 = ([94,2]*[94,1]+[96,1]*[96,2]+[97,2]*[97,1]+[98,1]*[98,2]+[105,2]*[105,1])/max(1,m_load5)
T_chws_set5 = 8
T_return_floor5 = Chiller_on5*T_return_raw5 + (1-Chiller_on5)*(T_chws_set5 + 5)
m_bgs5 = 14380*cool_bgs5
m_hys5 = 7420*cool_hys5
m_cs5 = 2290*cool_cs5
m_zl5 = 6635*cool_zl5
m_oa5 = [105,2]*[99,1]
m_load5 = m_bgs5+m_hys5+m_cs5+m_zl5+m_oa5
m_min5 = 0.3*30725
m_chiller5 = max( Chiller_on5 * max(m_load5, m_min5), 0.01 )
m_bypass5 = max(0,m_chiller5-m_load5)
m_oa_bgs5 = 0.60*[105,6]
m_oa_hys5 = 0.25*[105,6]
m_oa_zl5 = 0.15*[105,6]
T_bgs5 = ([94,3]*[94,6] + m_oa_bgs5*[105,3])/max(0.01,m_oa_bgs5+[94,6])
T_hys5 = ([96,3]*[96,6] + m_oa_hys5*[105,3])/max(0.01,m_oa_hys5+[96,6])
T_cs5 = ([97,3]*[97,6] )/max(0.01,[97,6])
T_zl5 = ([98,3]*[98,6] + m_oa_zl5*[105,3])/max(0.01,m_oa_zl5+[98,6])
W_bgs5 = ([94,6]*[94,4] + [105,4]* m_oa_bgs5)/max(0.01, m_oa_bgs5+[94,6])
W_hys5 = ([96,6]*[96,4] + [105,4]*m_oa_hys5)/max(0.01, m_oa_hys5+[96,6])
W_cs5 = ([97,6]*[97,4] )/max(0.01,[97,6])
W_zl5 = ([98,6]*[98,4] + [105,4]*m_oa_zl5)/max(0.01,m_oa_zl5+[98,6])
m_oa_coil5 = [99,1]*12500
W_oa_want5 = 0.0095
m_oa_air5 = [99,1]*5200
*$UNIT_NAME Equa-7
*$LAYER Main
*$POSITION 1306 1866
*$UNIT_NUMBER 100

