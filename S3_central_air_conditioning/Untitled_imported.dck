* EQUATIONS "Equa-11"
* 
EQUATIONS 39
ACH_bgs9 = ([154,6]+m_oa_bgs9)/(1.2*V_BGS9)
V_BGS9 = 800*4.9
V_HYS9 = 400*4.9
V_CS9 = 99.2*4.9
V_ZL9 = 300.034*4.9
cool_bgs9 = [159,1]*[161,1]
cool_hys9 = [159,1]*[162,1]
cool_cs9 = [159,1]*[163,1]
cool_zl9 = [159,1]*[164,1]
ACH_hys9 = ([156,6]+m_oa_hys9)/(1.2*V_HYS9)
ACH_cs9 = ([157,6])/(1.2*V_CS9)
ACH_zl9 = ([158,6]+m_oa_zl9)/(1.2*V_ZL9)
Chiller_on9 = max(max(cool_zl9,cool_hys9),max(cool_bgs9,cool_cs9))
T_return_raw9 = ([154,2]*[154,1]+[156,1]*[156,2]+[157,2]*[157,1]+[158,1]*[158,2]+[165,2]*[165,1])/max(1,m_load9)
T_chws_set9 = 8
T_return_floor9 = Chiller_on9*T_return_raw9 + (1-Chiller_on9)*(T_chws_set9 + 5)
m_bgs9 = 14380*cool_bgs9
m_hys9 = 7420*cool_hys9
m_cs9 = 2290*cool_cs9
m_zl9 = 6635*cool_zl9
m_oa9 = [165,2]*[159,1]
m_load9 = m_bgs9+m_hys9+m_cs9+m_zl9+m_oa9
m_min9 = 0.3*30725
m_chiller9 = max( Chiller_on9 * max(m_load9, m_min9), 0.01 )
m_bypass9 = max(0,m_chiller9-m_load9)
m_oa_bgs9 = 0.60*[165,6]
m_oa_hys9 = 0.25*[165,6]
m_oa_zl9 = 0.15*[165,6]
T_bgs9 = ([154,3]*[154,6] + m_oa_bgs9*[165,3])/max(0.01,m_oa_bgs9+[154,6])
T_hys9 = ([156,3]*[156,6] + m_oa_hys9*[165,3])/max(0.01,m_oa_hys9+[156,6])
