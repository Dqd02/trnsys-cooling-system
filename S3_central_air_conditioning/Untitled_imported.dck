* EQUATIONS "Equa-5"
* 
EQUATIONS 39
ACH_bgs3 = ([62,6]+m_oa_bgs3)/(1.2*V_BGS3)
V_BGS3 = 800*4.9
V_HYS3 = 400*4.9
V_CS3 = 99.2*4.9
V_ZL3 = 300.034*4.9
cool_bgs3 = [67,1]*[69,1]
cool_hys3 = [67,1]*[70,1]
cool_cs3 = [67,1]*[71,1]
cool_zl3 = [67,1]*[72,1]
ACH_hys3 = ([64,6]+m_oa_hys3)/(1.2*V_HYS3)
ACH_cs3 = ([65,6])/(1.2*V_CS3)
ACH_zl3 = ([66,6]+m_oa_zl3)/(1.2*V_ZL3)
Chiller_on3 = max(max(cool_zl3,cool_hys3),max(cool_bgs3,cool_cs3))
T_return_raw3 = ([62,2]*[62,1]+[64,1]*[64,2]+[65,2]*[65,1]+[66,1]*[66,2]+[73,2]*[73,1])/max(1,m_load3)
T_chws_set3 = 8
T_return_floor3 = Chiller_on3*T_return_raw3 + (1-Chiller_on3)*(T_chws_set3 + 5)
m_bgs3 = 14380*cool_bgs3
m_hys3 = 7420*cool_hys3
m_cs3 = 2290*cool_cs3
m_zl3 = 6635*cool_zl3
m_oa3 = [73,2]*[67,1]
m_load3 = m_bgs3+m_hys3+m_cs3+m_zl3+m_oa3
m_min3 = 0.3*30725
m_chiller3 = max( Chiller_on3 * max(m_load3, m_min3), 0.01 )
m_bypass3 = max(0,m_chiller3-m_load3)
m_oa_bgs3 = 0.60*[73,6]
m_oa_hys3 = 0.25*[73,6]
m_oa_zl3 = 0.15*[73,6]
T_bgs3 = ([62,3]*[62,6] + m_oa_bgs3*[73,3])/max(0.01,m_oa_bgs3+[62,6])
T_hys3 = ([64,3]*[64,6] + m_oa_hys3*[73,3])/max(0.01,m_oa_hys3+[64,6])
T_cs3 = ([65,3]*[65,6] )/max(0.01,[65,6])
T_zl3 = ([66,3]*[66,6] + m_oa_zl3*[73,3])/max(0.01,m_oa_zl3+[66,6])
W_bgs3 = ([62,6]*[62,4] + [73,4]* m_oa_bgs3)/max(0.01, m_oa_bgs3+[62,6])
W_hys3 = ([64,6]*[64,4] + [73,4]*m_oa_hys3)/max(0.01, m_oa_hys3+[64,6])
W_cs3 = ([65,6]*[65,4] )/max(0.01,[65,6])
W_zl3 = ([66,6]*[66,4] + [73,4]*m_oa_zl3)/max(0.01,m_oa_zl3+[66,6])
m_oa_coil3 = [67,1]*12500
W_oa_want3 = 0.0095
m_oa_air3 = [67,1]*5200
*$UNIT_NAME Equa-5
*$LAYER Main
*$POSITION 1102 1663
*$UNIT_NUMBER 68

