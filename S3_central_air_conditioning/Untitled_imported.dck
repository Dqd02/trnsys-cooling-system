* EQUATIONS "Equa-3"
* 
EQUATIONS 39
ACH_bgs1 = ([30,6]+m_oa_bgs1)/(1.2*V_BGS)
V_BGS = 800*4.9
V_HYS = 400*4.9
V_CS = 99.2*4.9
V_ZL = 300.034*4.9
cool_bgs = [38,1]*[33,1]
cool_hys = [38,1]*[40,1]
cool_cs = [38,1]*[41,1]
cool_zl = [38,1]*[42,1]
ACH_hys1 = ([35,6]+m_oa_hys1)/(1.2*V_HYS)
ACH_cs1 = ([36,6])/(1.2*V_CS)
ACH_zl1 = ([37,6]+m_oa_zl1)/(1.2*V_ZL)
Chiller_on = max(max(cool_zl,cool_hys),max(cool_bgs,cool_cs))
T_return_raw = ([30,2]*[30,1]+[35,1]*[35,2]+[36,2]*[36,1]+[37,1]*[37,2]+[43,2]*[43,1])/max(1,m_load)
T_chws_set = 8
T_return_floor = Chiller_on*T_return_raw + (1-Chiller_on)*(T_chws_set + 5)
m_bgs = 14380*cool_bgs+0.001
m_hys = 7420*cool_hys+0.001
m_cs = 2290*cool_cs+0.001
m_zl = 6635*cool_zl+0.001
m_oa = [43,2]*[38,1]
m_load = m_bgs+m_hys+m_cs+m_zl+m_oa
m_min = 0.3*30725
m_chiller = max( Chiller_on * max(m_load, m_min), 0.01 )
m_bypass = max(0,[25,2]-m_load)
m_oa_bgs1 = 0.60*[43,6]
m_oa_hys1 = 0.25*[43,6]
m_oa_zl1 = 0.15*[43,6]
T_bgs1 = ([30,3]*[30,6] + m_oa_bgs1*[43,3])/max(0.01,m_oa_bgs1+[30,6])
T_hys1 = ([35,3]*[35,6] + m_oa_hys1*[43,3])/max(0.01,m_oa_hys1+[35,6])
T_cs1 = ([36,3]*[36,6] )/max(0.01,[36,6])
T_zl1 = ([37,3]*[37,6] + m_oa_zl1*[43,3])/max(0.01,m_oa_zl1+[37,6])
W_bgs1 = ([30,6]*[30,4] + [43,4]* m_oa_bgs1)/max(0.01, m_oa_bgs1+[30,6])
W_hys1 = ([35,6]*[35,4] + [43,4]*m_oa_hys1)/max(0.01, m_oa_hys1+[35,6])
W_cs1 = ([36,6]*[36,4] )/max(0.01,[36,6])
W_zl1 = ([37,6]*[37,4] + [43,4]*m_oa_zl1)/max(0.01,m_oa_zl1+[37,6])
m_oa_coil = [38,1]*12500+0.001
W_oa_want = 0.0095
m_oa_air = [38,1]*5200+0.001
*$UNIT_NAME Equa-3
*$LAYER Main
*$POSITION 674 511
*$UNIT_NUMBER 39

