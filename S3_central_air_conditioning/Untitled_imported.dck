* EQUATIONS "Equa-14"
* 
EQUATIONS 39
ACH_bgs12 = ([199,6]+m_oa_bgs12)/(1.2*V_BGS12)
V_BGS12 = 800*4.9
V_HYS12 = 400*4.9
V_CS12 = 99.2*4.9
V_ZL12 = 300.034*4.9
cool_bgs12 = [204,1]*[206,1]
cool_hys12 = [204,1]*[207,1]
cool_cs12 = [204,1]*[208,1]
cool_zl12 = [204,1]*[209,1]
ACH_hys12 = ([201,6]+m_oa_hys12)/(1.2*V_HYS12)
ACH_cs12 = ([202,6])/(1.2*V_CS12)
ACH_zl12 = ([203,6]+m_oa_zl12)/(1.2*V_ZL12)
Chiller_on12 = max(max(cool_zl12,cool_hys12),max(cool_bgs12,cool_cs12))
T_return_raw12 = ([199,2]*[199,1]+[201,1]*[201,2]+[202,2]*[202,1]+[203,1]*[203,2]+[210,2]*[210,1])/max(1,m_load12)
T_chws_set12 = 8
T_return_floor12 = Chiller_on12*T_return_raw12 + (1-Chiller_on12)*(T_chws_set12 + 5)
m_bgs12 = 14380*cool_bgs12
m_hys12 = 7420*cool_hys12
m_cs12 = 2290*cool_cs12
m_zl12 = 6635*cool_zl12
m_oa12 = [210,2]*[204,1]
m_load12 = m_bgs12+m_hys12+m_cs12+m_zl12+m_oa12
m_min12 = 0.3*30725
m_chiller12 = max( Chiller_on12 * max(m_load12, m_min12), 0.01 )
m_bypass12 = max(0,m_chiller12-m_load12)
m_oa_bgs12 = 0.60*[210,6]
m_oa_hys12 = 0.25*[210,6]
m_oa_zl12 = 0.15*[210,6]
T_bgs12 = ([199,3]*[199,6] + m_oa_bgs12*[210,3])/max(0.01,m_oa_bgs12+[199,6])
T_hys12 = ([201,3]*[201,6] + m_oa_hys12*[210,3])/max(0.01,m_oa_hys12+[201,6])
T_cs12 = ([202,3]*[202,6] )/max(0.01,[202,6])
T_zl12 = ([203,3]*[203,6] + m_oa_zl12*[210,3])/max(0.01,m_oa_zl12+[203,6])
W_bgs12 = ([199,6]*[199,4] + [210,4]* m_oa_bgs12)/max(0.01, m_oa_bgs12+[199,6])
W_hys12 = ([201,6]*[201,4] + [210,4]*m_oa_hys12)/max(0.01, m_oa_hys12+[201,6])
W_cs12 = ([202,6]*[202,4] )/max(0.01,[202,6])
W_zl12 = ([203,6]*[203,4] + [210,4]*m_oa_zl12)/max(0.01,m_oa_zl12+[203,6])
m_oa_coil12 = [204,1]*12500
W_oa_want12 = 0.0095
m_oa_air12 = [204,1]*5200
*$UNIT_NAME Equa-14
*$LAYER Main
*$POSITION 1670 2260
*$UNIT_NUMBER 205

