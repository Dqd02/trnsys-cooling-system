*------------------------------------------------------------------------------                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                         
* EQUATIONS "冷却塔信号"                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                
*                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                       

  EQUATIONS  26
     CpW2 = 4.19
!冷却塔出水温度下限，°C。                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                 
     TWC_MIN = 20
!冷却塔目标出水温度上限，°C。                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                             
     TWC_MAX = 32
! 冷却塔目标逼近度，K。                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                  
     CT_APPROACH = 4
! 冷却塔动态目标出水温度，°C。                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                  
     TWC_set = min(TWC_MAX,max(TWC_MIN,[23,3]+CT_APPROACH))
! 单台Type510的额定散热量，kJ/h。冷却塔散热量 = 冷机蒸发器制冷量 + 压缩机输入功率;QCT_R即 m_cw,R×CpW×ΔT_R                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            
     QCT_R = 9376214
! 冷却塔风机最低相对转速。                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                
     FAN_MIN = 0.25
! 出水温度偏差修正系数，单位近似为1/K。                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                     
     KP_CT = 0.10
! 冷却塔允许启动的最低检测流量，kg/h。                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                
     CW_FLOW_ON = 75000
!Type666的实际冷凝排热量，kJ/h。                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    
     Qrej1 = max(0,[9,6])
     Qrej2 = max(0,[12,6])
!该判断可以避免无水流时冷却塔风机仍然运行。                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                             
     FlowOK1 = gt([9,4] , CW_FLOW_ON)
     FlowOK2 = gt([12,4] , CW_FLOW_ON)
     QFrac1 = min(1,Qrej1/QCT_R)
!当前排热量占冷却塔额定散热量的比例。                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        
     QFrac2 = min(1,Qrej2/QCT_R)
!估算得到的冷却塔出水温度                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                       
     ToutEst1 = [9,3] - Qrej1/(CpW2*max(CW_FLOW_ON , [9,4]))
     ToutEst2 = [12,3] - Qrej2/(CpW2*max(CW_FLOW_ON , [12,4]))
!生成0.25～1.00的正变频信号                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            
     FanCmd1 = max(FAN_MIN,min(1,FAN_MIN+(1-FAN_MIN)*QFrac1+KP_CT*(ToutEst1-TWC_set)))
     FanCmd2 = max(FAN_MIN,min(1,FAN_MIN+(1-FAN_MIN)*QFrac2+KP_CT*(ToutEst2-TWC_set)))
!生成Type510最终风机控制信号                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                           
     Fan1 = Tower1_ON*FlowOK1*FanCmd1
     Fan2 = Tower2_ON*FlowOK2*FanCmd2
     Spray1_ON = gt(Fan1,0)
     Spray2_ON = gt(Fan2,0)
!市场产品中喷淋泵通常采用全流量启停，不随风机一起变频                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                         
     P_spray1 = 43200*Spray1_ON
     P_spray2 = 43200*Spray2_ON
!功能重复                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                
     P_sprat_all = 0
