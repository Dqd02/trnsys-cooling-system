*** INITIAL INPUT VALUES                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                
       1.0000000000000000E+01    1.0000000000000000E+02    1.0000000000000000E+01
*------------------------------------------------------------------------------                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                         
* EQUATIONS "判断"                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                      
*                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                       

  EQUATIONS  24
! 将负荷由 kJ/h 折算为 kW；                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                  
     LoadKW = max(0,[22,1]/3600)
! 有效制冷需求判断；5 kW 用于过滤数值噪声，避免零负荷时误开泵                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                     
     HasLoad = gt(LoadKW,5)
! 当前仿真时刻在一天内的小时数；例如 0-8 为夜间蓄冷窗口。                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                               
     HourOfDay = time-24*int(time/24)
! 从 TRNSYS 绝对仿真时间得到日序号；需与负荷文件首日星期对应关系校准。                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                             
     DayNum = int(time/24)
! 未校准的周内索引，范围 0-6 循环。                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                  
     WeekIndex0 = DayNum-7*int(DayNum/7)
! 星期偏移量；必须根据 load_year_15min_new.csv 的首日实际星期校准。                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    
     WeekdayOffset = 0
! 加入偏移量后的周内索引。                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                       
     RawWeekIndex = WeekIndex0+WeekdayOffset
! 归一化后的周内索引；建议约定 0=周一，1=周二，...，6=周日。                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                
     Weekday = RawWeekIndex-7*int(RawWeekIndex/7)
! 工作日判断；周一到周五为 1，周六周日为 0。                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                   
     IsWorkday = lt(Weekday,5)
! 白天供冷时间窗；8:00-22:00 为 1，其余时间为 0。                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                          
     IsLoadTime = ge(HourOfDay,8)*lt(HourOfDay,22)
! 仅工作日 8:00-22:00 且负荷大于噪声阈值时进入供冷判断。                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                       
     LoadWindow = IsWorkday*IsLoadTime*HasLoad
! 水的比热                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    
     CpW = 4.19
! 设计供回水温差                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                              
     DTCHW = 5
!单台供冷泵额定质量流量，kg/h                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            
     MCHWR = 215000
     Chiller1_ON = LoadWindow
     Chiller2_ON = LoadWindow
! 冷却塔1与冷机1同步                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                             
     Tower1_ON = Chiller1_ON
! 冷却塔2与冷机2同步                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                             
     Tower2_ON = Chiller2_ON
!由建筑冷负荷计算总需求质量流量                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                           
     MREQ = LoadKW*3600/(CpW*DTCHW)
!给流量增加输送裕量                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                  
     MDCHREQ = 1.10*MREQ
!双冷机供冷时，每台供冷泵承担总流量的一半                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                           
     CHW_one = MDCHREQ/2
     CHW_CTRL = min(1,CHW_one/MCHWR)*LoadWindow
     Gamma14 = 0.5
     CHW_SET = 10
*$UNIT_NAME 判断                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        
