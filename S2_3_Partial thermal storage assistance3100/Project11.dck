lengji_all = ([9,5]+[12,5])/3600
tower = ([18,5]+[21,5])/3600
pump_all = ([32,3]+[6,3]+[34,3]+[10,3]+[13,3]+[19,3]+[20,3]+[51,3]+[52,3])/3600
E_ALL = lengji_all+tower+pump_all
E_CO2_2025 = E_ALL*[36,1]
E_CO2_40TH = [36,2]*E_ALL
E_CO2_60TH = [36,3]*E_ALL
*$UNIT_NAME 能耗
