*------------------------------------------------------------------------------

* EQUATIONS "状态判断"
* 
EQUATIONS 43
T_cold_sp = 4 ! 供冷设计温度-----------------------------------------------------------------------水箱状态监控
T_warm_ref = 12 ! 回水暖态度参考温度
dT_dead = 1 ! 温度判断死区
SOC = max(0,min(1,(T_warm_ref-[7,5])/(T_warm_ref-T_cold_sp))) !蓄冷量状态SOC（0=完全暖/空, 1=完全冷/满）
TankFull = lt([7,18], T_cold_sp + dT_dead)*lt([7,30],T_cold_sp + 1.5) !蓄满：顶部节点AND中部节点均接近供冷温度
TankEmpty = gt([7,42],T_warm_ref-dT_dead)*gt([7,30],T_warm_ref-3)
Chg_bySOC = lt(SOC,0.9)*(1-TankFull) ! SOC < 0.9: 允许开始蓄冷
Dch_bySOC = gt(SOC,0.1)*(1-TankEmpty) ! SOC > 10% 且 水箱未空 → 允许释冷
HourOfDay = time-24*int(time/24) !当前时刻在一天中的小时数----------------------------------时间判断
DayNum = int(time/24) !从仿真开始算起的第几天
WeekIndex0 = DayNum-7*int(DayNum/7) !周内循环索引 DayNum对7取余数
Weekday0ffset = 0 ! 偏移量
RawWeekIndex = WeekIndex0+Weekday0ffset !加上偏移后的原始索引
Weekday = RawWeekIndex-7*int(RawWeekIndex/7) !WeekDay = 0 代表周一，1=周二 ... 6=周日
IsWorkday = lt(Weekday,5) !判断工作日，0-4是工作日，信号为1
IsChargeTime = lt(HourOfDay,8) !判断充电时间0到8点
IsLoadTime = ge(HourOfDay,8)*lt(HourOfDay,22) !8:00~22:00 为用电/放电时段（峰电或设备运行时段，信号=1）
ChargeWindow = IsWorkday*IsChargeTime
LoadWindow = IsWorkday*IsLoadTime ! 工作日负荷窗口
BaseCap_kW = 2200       ! 基载冷机容量（kW）--------------------------------------------------基本参数与设定
PeakAssist_kW = 1100    ! 辅助削峰容量（kW）
JointCap_kW = 3300      ! 联合供冷总容量（kW）
AssistStart_kW = BaseCap_kW * 1.10  ! 2420 kW（启动削峰的负荷阈值）
BaseFlow = 236000       ! 基载流量（kg/h）
AssistFlow = 118000     ! 辅助流量（kg/h）
JointFlow = 354000      ! 联合总流量（kg/h）
Load_kw = [22,1]/3600 !负荷kw
NeedAssist = GT(Load_kw, AssistStart_kW)   ! 是否需要削峰辅助
ChargeMode = ChargeWindow * Chg_bySOC   ! 蓄冷模式--------------------------------------模式判定
BaseOnlyMode = LoadWindow * (1 - NeedAssist)    ! 基载单独供冷
JointMode = LoadWindow * NeedAssist * Dch_bySOC   ! 基载+水箱联合供冷
BaseFallbackMode = LoadWindow * NeedAssist * (1 - Dch_bySOC) !如果需要削峰但水箱不可释冷，则退回冷机基载直供
BaseSupplyMode = MIN(1, BaseOnlyMode + BaseFallbackMode)
LoadChillerMode = MIN(1, BaseSupplyMode + JointMode)
ChillerMode = MIN(1, ChargeMode + LoadChillerMode)
Sig_Chiller = ChillerMode !冷机、供冷水泵、冷却水泵、冷却塔-----------------------------设备启停信号
Sig_ChargePump32 = ChargeMode     ! 蓄冷水泵
Sig_DischargePump6 = JointMode    ! 释冷电泵
Sig_UserReturnPump33 = BaseSupplyMode   ! 回水泵（基载侧）
Sig_JointReturnPump36 = JointMode       ! 回水泵（联合侧）
Gamma_U14 = 0.5   ! 固定旁通阀开度50%
Gamma_U24 = ChargeMode   ! 充电时切换至水箱 Unit24: 0 -> 供冷总管, 1 -> 蓄冷水泵/水箱
Gamma_U29 = 1 - JointMode * (AssistFlow / JointFlow) ! Unit29: outlet1 = 1-gamma 去水箱, outlet2 = gamma 去冷机
*$UNIT_NAME 状态判断
*$LAYER Main
*$POSITION 933 63
*$UNIT_NUMBER 34

