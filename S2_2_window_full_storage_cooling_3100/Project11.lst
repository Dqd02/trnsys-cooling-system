     tower_all = ([18,5]+[21,5]+[37,5])/3600
     pump_all = ([33,3]+[6,3]+[32,3]+[10,3]+[13,3]+[34,3]+[19,3]+[20,3]+[38,3])/3600
     E_all = lengji_all+tower_all+pump_all
     E_CO2_2025 = E_all*[36,1]
     E_CO2_40TH = E_all*[36,2]
     E_CO2_60TH = E_all*[36,3]
