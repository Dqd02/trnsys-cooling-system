  ASSIGN CO2_window.csv   50
*|? Input file name |1000                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                               
*------------------------------------------------------------------------------                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                         
* EQUATIONS "Equa"                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                      
*                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                       

  EQUATIONS  46
! 冷水目标温度；冷机1/2蓄冷和冷机3直供均可采用 4 C 作为 CHW Set Point                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                      
     T_cold_sp = 4
! 暖态回水参考温度；用于定义蓄冷罐接近放空时的温度基准                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                   
     T_warm_ref = 12
! 温度判断死区；避免节点温度在单个时间步内小幅波动造成频繁切换                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                               
     dT_dead = 1
! 将负荷由 kJ/h 折算为 kW，便于设置有效负荷阈值                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                     
     LoadKW = [22,1]/3600
! 有效负荷判断；低于 5 kW 视为无制冷需求或数值噪声。                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                              
     HasLoad = gt(LoadKW,5)
! 将窗口信号限制在 0-1，防止文件读入异常值影响控制。                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                  
     Window_time = max(0,min(1,[40,1]))
! 将窗口信号转为布尔变量；1 表示当前时间步为蓄冷窗口。                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    
     IsWindow = gt(Window_time,0.5)
! 按平均温度估算蓄冷状态；越接近 4 C，SOC 越高                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                       
     SOC_raw = (T_warm_ref-[7,5])/(T_warm_ref-T_cold_sp)
! 限幅后的蓄冷状态；0=接近空罐，1=接近满罐                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                   
     SOC = max(0,min(1,SOC_raw))
! 顶部和中部均接近冷水温度时，认为水箱已基本蓄满                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            
     TankFull = lt([7,18],T_cold_sp+0.5)*lt([7,30],T_cold_sp+1.5)
! 底部和中部均偏暖时，认为水箱可用冷量不足                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                             
     TankEmpty = gt([7,42],T_warm_ref-dT_dead)*gt([7,30],T_warm_ref-3)
! 无记忆 Equation 近似版：水箱未接近满罐且节点未满时允许蓄冷。                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                 
     Chg_bySOC_alg = lt(SOC,0.95)*(1-TankFull)
! 释冷许可：水箱 SOC 足够且未达到空罐节点判据时允许释冷                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            
     Dch_bySOC = gt(SOC,0.1)*(1-TankEmpty)
! 当前仿真时刻在一天内的小时数。                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        
     HourOfDay = time-24*int(time/24)
! 从 TRNSYS 绝对时间计算日序号。                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                   
     DayNum = int(time/24)
! 未校准周内索引，0-6 循环。                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                         
     WeekIndex0 = DayNum-7*int(DayNum/7)
! 星期偏移量                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                           
     WeekdayOffset = 0
! 加入星期偏移后的周内索引。                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                     
     RawWeekIndex = WeekIndex0+WeekdayOffset
! 归一化周内索引；建议约定 0=周一，1=周二，...，6=周日。                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    
     Weekday = RawWeekIndex-7*int(RawWeekIndex/7)
! 工作日判断；周一至周五为 1，周六周日为 0。                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                   
     IsWorkday = lt(Weekday,5)
! 负荷时间判断；工作日 8:00-22:00 才允许出现供冷需求。                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                     
     IsLoadTime = ge(HourOfDay,8)*lt(HourOfDay,22)
! 有效供冷需求窗口；周末、非 8-22、无负荷时均为 0。                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            
     LoadWindow = IsWorkday*IsLoadTime*HasLoad
! 工作日窗口蓄冷许可；不再固定 0-8 点，只看外部窗口信号。                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                              
     ChargeWindow = IsWorkday*IsWindow
! 蓄冷模式：工作日窗口内且水箱未满时，冷机1/2联合蓄冷。                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                          
     ChargeMode = ChargeWindow*Chg_bySOC_alg
! 窗口内若有负荷，负荷由冷机3直供；此时不使用水箱释冷。                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                         
     Direct3_Window = ChargeWindow*LoadWindow
! 非窗口内有负荷且水箱可用时，优先由水箱释冷。                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                          
     TankMode = (1-ChargeWindow)*LoadWindow*Dch_bySOC
! 非窗口内有负荷但水箱冷量不足时，冷机3作为备用直供。                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                         
     Direct3_Backup = (1-ChargeWindow)*LoadWindow*(1-Dch_bySOC)
! 冷机3直供总模式；包括窗口内带负荷直供和非窗口水箱不足直供。                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                         
     Direct3Mode = min(1,Direct3_Window+Direct3_Backup)
! 停机检查变量；不直接控制设备，用于确认是否没有任何运行模式。                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                      
     OffMode = (1-min(1,ChargeMode+TankMode+Direct3Mode))
! 冷机1只在窗口蓄冷模式开启，不承担负荷直供。                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                   
     Chiller1_ON = ChargeMode
! 冷机2只在窗口蓄冷模式开启，与冷机1共同向水箱蓄冷。                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            
     Chiller2_ON = ChargeMode
! 供冷水泵-1与冷机1同步，避免冷机1无流量运行。                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                   
     Pump10_ON = Chiller1_ON
! 供冷水泵-2与冷机2同步，避免冷机2无流量运行。                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                   
     Pump13_ON = Chiller2_ON
! Unit32 蓄冷水泵只在冷机1/2给水箱蓄冷时开启。                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                              
     ChargePump32_ON = ChargeMode
! 冷机3只承担负荷直供：窗口内有负荷，或非窗口水箱不足时开启。                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                  
     Chiller3_ON = Direct3Mode
! 供冷水泵-3与冷机3同步。                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        
     Pump34_ON = Chiller3_ON
! Unit6 释冷水泵只在非窗口水箱释冷模式开启。                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                
     DischargePump6_ON = TankMode
! Unit33 回水水泵在所有有负荷供冷模式开启；纯蓄冷无负荷时关闭。                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            
     ReturnPump33_ON = min(1,TankMode+Direct3Mode)
! 冷却水泵1与冷机1同步。                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        
     CWPump1_ON = Chiller1_ON
! 冷却水泵2与冷机2同步。                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        
     CWPump2_ON = Chiller2_ON
! 冷却水泵3与冷机3同步。                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        
     CWPump3_ON = Chiller3_ON
! 冷却塔1与冷机1同步。                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                           
     Tower1_ON = Chiller1_ON
! 冷却塔2与冷机2同步。                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                           
     Tower2_ON = Chiller2_ON
! 冷却塔3与冷机3同步。                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                           
     Tower3_ON = Chiller3_ON
! Unit14 分流阀-2：蓄冷时 gam=0.5，将管道-4回水均分至冷机1/2；非蓄冷时该回路无主流量，置 0 不影响负荷回路。                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                     
     Gamma14 = 0.5*ChargeMode
! Unit29 分流阀-3：水箱释冷时 gam=0，回水走 outlet1 回蓄冷罐；冷机3直供时 gam=1，回水走 outlet2 回冷机3。                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                          
     Gamma29 = Direct3Mode
*$UNIT_NAME Equa                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        
*$LAYER Main                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            
