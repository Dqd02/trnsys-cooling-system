* Model "合流阀-3" (Type 11)                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            
*                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                       

  UNIT   37     TYPE   11     合流阀-3                                      
*$UNIT_NAME 合流阀-3                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    
*$MODEL .\Hydronics\Tee-Piece Flow Mixer\Other Fluids\Type11h.tmf                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                       
*$POSITION 233 436                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                      
*$LAYER Main #                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                          
       PARAMETERS   1
! 1 Tee piece mode                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                   
       1.0000000000000000E+00
       INPUTS    4
! 蓄冷罐:Temperature at Outlet-2 ->Temperature at inlet 1                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                         
! 蓄冷罐:Flowrate at Outlet-2 ->Flow rate at inlet 1                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                              
! 分流阀-3:Temperature at outlet 2 ->Temperature at inlet 2                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                      
! 分流阀-3:Flow rate at outlet 2 ->Flow rate at inlet 2                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                          
       7,3                                      7,4                                      29,3                                     29,4                                    
*** INITIAL INPUT VALUES                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                
       1.0000000000000000E+01    1.0000000000000000E+05    2.0000000000000000E+01    1.0000000000000000E+05
*------------------------------------------------------------------------------                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                         
* EQUATIONS "控制"                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                      
*                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                       

  EQUATIONS  67
! 水箱冷态参考温度与冷机冷冻水出水设定值，°C；不代表所有冷机工况的出水设定                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                               
     T_cold_sp = 4
! 水箱暖态参考温度与设计回水温度，°C；不代表10℃直供时的固定建筑回水温度                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                               
     T_warm_ref = 12
! 水箱温度判断死区，K                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                       
     dT_dead = 1
! 水的定压比热，kJ/(kg·K)                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                   
     CpW = 4.19
! 按水箱工况8 K计算基础需求流量，kg/h                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                          
     MREQ_TANK = LoadKW*3600/(CpW*DTCHW_TANK)
! 水箱释冷流量增加10%裕度，kg/h                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                         
     MLOAD_REQ_TANK = 1.10*MREQ_TANK
! 蓄冷、释冷以及窗口内正常蓄冷工况的设计供回水温差，K                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                     
     DTCHW_TANK = 8
! 冷机直接供建筑负荷时的设计供回水温差，10/15℃，K                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                     
     DTCHW_DIRECT = 5
! 两台供冷泵合计额定流量，也是Unit32/34额定流量，kg/h                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                             
     MCHW_TOTAL_R = 430000
! 单台Unit56或57额定流量，kg/h                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                   
     MCHW_SINGLE_R = 215000
! Unit58释冷泵额定流量，kg/h                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            
     MDCH_R = 430000
! 当前时刻在一天内的小时数，范围0-24                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                   
     HourOfDay = time-24*int(time/24)
! 当前仿真日序号                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                  
     DayNum = int(time/24)
! 未校准的周内索引，范围0-6                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                         
     WeekIndex0 = DayNum-7*int(DayNum/7)
! 星期偏移量；当前负荷文件口径取0                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                     
     WeekdayOffset = 0
! 加入星期偏移                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                  
     RawWeekIndex = WeekIndex0+WeekdayOffset
! 将周内索引归一化为0-6                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    
     Weekday = RawWeekIndex-7*int(RawWeekIndex/7)
! 周一至周五为1，周末为0                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                      
     IsWorkday = lt(Weekday,5)
! 严格建筑供冷时段[8:00,22:00)                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            
     IsLoadTime = ge(HourOfDay,8)*lt(HourOfDay,22)
! 门控后送入建筑端和控制器的负荷，kJ/h                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                       
     BuildingLoad = [22,1]*IsWorkday*IsLoadTime
! 建筑负荷由kJ/h换算为kW                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                     
     LoadKW = BuildingLoad/3600
! 负荷大于5 kW时为1，过滤数值噪声                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                
     HasLoad = gt(LoadKW,5)
! 工作日8-22点且有有效负荷时为1                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                               
     LoadWindow = IsWorkday*IsLoadTime*HasLoad
! 将外部净负荷窗口信号限制在0-1                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                     
     WindowSignal = max(0,min(1,[39,3]))
! 外部窗口信号大于0.5时判定为蓄冷窗口                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                   
     IsWindow = gt(WindowSignal,0.5)
! 蓄冷窗口直接采用外部信号，不再乘IsWorkday                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                           
     ChargeWindow = IsWindow*IsWorkday
! 按水箱平均温度估算蓄冷SOC                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                         
     SOC_raw = (T_warm_ref-[7,5])/(T_warm_ref-T_cold_sp)
! 将SOC限制在0-1；0为空/暖，1为满/冷                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        
     SOC = max(0,min(1,SOC_raw))
! 顶部和中部均接近冷态时判满                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                           
     TankFull = lt([7,18],T_cold_sp+0.5)*lt([7,30],T_cold_sp+dT_dead)
! 底部和中部均偏暖时判空                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                              
     TankEmpty = gt([7,42],T_warm_ref-dT_dead)*gt([7,30],T_warm_ref-3)
!type2蓄冷停止滞回的监测量；TankFull=1时强制将监测量提升到1，使滞回控制器进入停止蓄冷状态                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                   
     SOC_Stop = max(SOC,TankFull)
!Type2未锁定停止且水箱未判满时允许蓄冷；带0.93/0.95 SOC滞回                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                          
     Chg_bySOC = (1-[60,1])*(1-TankFull)
! SOC高于0.10且未判空时允许释冷                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                  
     Dch_bySOC = gt(SOC,0.10)*(1-TankEmpty)
! 不含裕度的建筑需求质量流量，kg/h                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                       
     MREQ = LoadKW*3600/(CpW*DTCHW)
! 含10%裕度的建筑需求质量流量，kg/h                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                               
     MLOAD_REQ = 1.10*MREQ
! 相对于两台供冷泵总额定流量的控制比例                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                  
     LoadFrac = min(1,max(0,MLOAD_REQ/MCHW_TOTAL_R))
! 释冷泵额定流量是否足以覆盖水箱供冷需求                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                         
     TankFlowOK = le(MLOAD_REQ_TANK,MDCH_R)
! 水箱状态和释冷泵流量能力均满足时允许独立释冷                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                      
     TankCanCover = Dch_bySOC*TankFlowOK
! 窗口内且水箱未满时，蓄冷支路有效                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            
     WindowChargeMode = ChargeWindow*Chg_bySOC
! 窗口与建筑负荷同时出现时为1                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                  
     WindowLoadMode = ChargeWindow*LoadWindow
     WindowChillerMode = WindowChargeMode
! Type666出水设定：实际蓄冷时4℃；其余工况10℃，冷机停机时仅为待机值                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                      
     CHW_SP = max(4,min(10,10-6*WindowChargeMode))
! 非窗口、有负荷且水箱可用时释冷                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                           
     TankDischargeMode = (1-ChargeWindow)*LoadWindow*TankCanCover
! 非蓄冷窗口水箱不能覆盖负荷，或蓄冷窗口内水箱已满且仍有负荷时，由两台冷机直接供冷                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                   
     DirectChillerMode = LoadWindow * ((1 - ChargeWindow) * (1 - TankCanCover) + ChargeWindow * (1 - WindowChargeMode))
! 冷机直供建筑负荷时采用5 K，其余蓄冷、释冷和停机判断工况采用8 K                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                              
     DTCHW = DTCHW_DIRECT*DirectChillerMode + DTCHW_TANK*(1-DirectChillerMode)
! 三种主运行模式均未启用时为1                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                               
     OffMode = (1-WindowChillerMode)*(1-TankDischargeMode)*(1-DirectChillerMode)
! 冷机1在窗口制冷或非窗口直供时为1                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                               
     Chiller1_ON = max(WindowChillerMode,DirectChillerMode)
! 冷机2与冷机1同时开启和关闭                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                     
     Chiller2_ON = max(WindowChillerMode,DirectChillerMode)
! 非窗口双冷机直供时的单台供冷泵变频比例                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                             
     CHWP_Direct_CTRL = (1-ChargeWindow) * DirectChillerMode * LoadFrac
! Unit56：水箱未满时满流量蓄冷；窗口内停止蓄冷后及非窗口直供时按负荷变频                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                               
     CHWP1_CTRL = max(WindowChargeMode,WindowLoadMode*(1-WindowChargeMode)*LoadFrac+CHWP_Direct_CTRL)
! Unit57：与Unit56相同，两台泵均分建筑需求流量                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                         
     CHWP2_CTRL = max(WindowChargeMode,WindowLoadMode*(1-WindowChargeMode)*LoadFrac+CHWP_Direct_CTRL)
! 保留当前Unit56已有连接名称；实际为0-1连续信号                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                  
     Pump10_ON = CHWP1_CTRL
! 保留当前Unit57已有连接名称；实际为0-1连续信号                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                  
     Pump13_ON = CHWP2_CTRL
! 冷机1冷却水泵采用与供冷泵1相同的归一化信号                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                     
     CWP1_CTRL = CHWP1_CTRL
! 冷机2冷却水泵采用与供冷泵2相同的归一化信号                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                     
     CWP2_CTRL = CHWP2_CTRL
! Unit54和52的控制信号                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                           
     CWPump1_ON = CWP1_CTRL
! Unit51和55的控制信号                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                           
     CWPump2_ON = CWP2_CTRL
! Type126冷却塔1与冷机1同步，信号仅为0或1                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                       
     Tower1_ON = Chiller1_ON
! Type126冷却塔2与冷机2同步，信号仅为0或1                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                       
     Tower2_ON = Chiller2_ON
! Unit58按释冷需求加10%裕度变频                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                   
     DCHP_CTRL = TankDischargeMode*min(1,MLOAD_REQ/MDCH_R)
! 保留当前Unit58已有连接名称                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                              
     DischargePump6_ON = DCHP_CTRL
! Unit35流向负荷支路的分流比例                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                       
     Gamma35 = min(1,WindowLoadMode*(WindowChargeMode*LoadFrac+(1-WindowChargeMode))+DirectChillerMode)
! Unit32负荷支路泵信号，已经删除unit32                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                  
     Pump32_CTRL = min(1,WindowLoadMode*(WindowChargeMode*LoadFrac+(1-WindowChargeMode))+DirectChillerMode*LoadFrac)
! Unit34蓄冷支路泵信号；无负荷为1，有负荷取剩余比例                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                              
     Pump34_CTRL = WindowChargeMode*(1-LoadWindow*LoadFrac)
! Unit29：窗口负荷或冷机直供时回水走出口2回冷机                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                       
     Gamma29 = min(1,WindowLoadMode+DirectChillerMode)
! Unit14：两台冷机运行时各分50%回水                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                              
     Gamma14 = 0.5*max(WindowChillerMode,DirectChillerMode)
! 模式完备性监测量，正常应等于1                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            
     ModeSumCheck = WindowChillerMode+TankDischargeMode+DirectChillerMode+OffMode
