*------------------------------------------------------------------------------                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                         
* EQUATIONS "Equa"                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                      
*                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                       

  EQUATIONS  12
     HourOfDay = TIME-24*INT(TIME/24)
     DayNum = INT(TIME/24)
     WeekIndex0 = DayNum-7*INT(DayNum/7)
     WeekdayOffset = 0
     RawWeekIndex = WeekIndex0+WeekdayOffset
     Weekday = RawWeekIndex-7*INT(RawWeekIndex/7)
     IsWorkday = LT(Weekday,5)
     IsLoadTime = GE(HourOfDay,8)*le(HourOfDay,22)
     Qnoise = 3600
     HasLoad = GT([22,1],Qnoise)
     ScheduleEnable = IsWorkday*IsLoadTime
     PlantEnable = ScheduleEnable*HasLoad
*$UNIT_NAME Equa                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        
*$LAYER Main                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            
*$POSITION 948 74                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                       
*$UNIT_NUMBER 21                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        
*------------------------------------------------------------------------------                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                         
* EQUATIONS "功耗"                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                      
*                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                       

  EQUATIONS  14
     P_cold_source_kW = P_CHW_pump_kW+P_chiller_kW
     CO2_2025 = P_HVAC_total_kW*[36,1]
     CO2_40TH = P_HVAC_total_kW*[36,2]
     CO2_60TH = P_HVAC_total_kW*[36,3]
     P_CHW_pump_kW = ([16,3]+[17,3]+[18,3]+[19,3])/3600
     P_chiller_kW = ([6,3]+[13,3]+[14,3]+[15,3])/3600
     P_FCU_rated_kW = 45
     P_OA_rated_kW = 18
     P_AHU_rated_kW = 0
     P_FCU_fan_kW = P_FCU_rated_kW*PlantEnable
     P_OA_fan_kW = P_OA_rated_kW*PlantEnable
     P_AHU_fan_kW = P_AHU_rated_kW*PlantEnable
     P_airside_kW = P_FCU_fan_kW + P_OA_fan_kW + P_AHU_fan_kW
     P_HVAC_total_kW = P_cold_source_kW + P_airside_kW
*$UNIT_NAME 功耗                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        
